# ── Database ──────────────────────────────────────────────────────────────────
# Full Postgres connection string.
# Supabase:  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Neon:      postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Auth (used from Day 2 onward) ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
