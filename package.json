{
  "name": "fuel-distribution-system",
  "version": "0.1.0",
  "description": "Automated Fuel Distribution & Anti-Black-Market Control System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:check": "node src/db/check.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test:db:setup": "node test/helpers/migrateTestDb.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"],
    "globalSetup": "./jest.globalSetup.js",
    "testTimeout": 30000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
